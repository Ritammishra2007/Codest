{
  "name": "codest-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "A local 1v1 Python programming platform.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/project.mjs setup",
    "install:all": "node scripts/project.mjs install",
    "dev": "node scripts/project.mjs dev",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "test:runner": "npm --prefix backend run test:runner",
    "doctor": "npm --prefix backend run doctor",
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:status": "docker compose ps db",
    "db:setup": "npm --prefix backend run db:setup",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset",
    "studio": "npm --prefix backend run studio",
    "generate": "npm --prefix backend run generate",
    "db:migrate": "npm --prefix backend run db:migrate"
  }
}
